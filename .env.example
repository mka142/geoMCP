# Copy to .env and edit, or run `geomcp setup`. Never commit .env.

# --- Data-source credentials (free accounts) -------------------------------------------------
# Copernicus Data Space: create an OAuth client in the Sentinel Hub dashboard (dataspace.copernicus.eu).
GEOMCP_CDSE_CLIENT_ID=
GEOMCP_CDSE_CLIENT_SECRET=
# Climate Data Store: personal access token from your CDS profile page. Also accept the licence of
# reanalysis-era5-land-timeseries once on its Download tab, or requests fail with 403.
GEOMCP_CDS_KEY=

# Recommended for a team: a free GUS BDL API key raises the Local Data Bank limit from 1,000 to
# 5,000 requests per 12 hours (statistics tools). See docs/keys-registration.md.
# GEOMCP_GUS_BDL_KEY=
# Optional: a free GUS SMUP key (public-services indicators).
# GEOMCP_GUS_SMUP_KEY=
# Optional: GUS REGON (BIR) key; lookup_business then also covers sole traders. See docs/keys-registration.md.
# GEOMCP_REGON_KEY=
# Optional: CEIDG API token: find_businesses (sole traders by name, place and PKD) and sole-trader
# details in lookup_business. Requested at biznes.gov.pl; see docs/keys-registration.md.
# GEOMCP_CEIDG_TOKEN=

# --- Server ----------------------------------------------------------------------------------
# Contact sent in the User-Agent to public services (Nominatim's usage policy asks for one): an email or URL.
GEOMCP_CONTACT=
# Public HTTPS address users reach (your nginx); download links are built from it.
GEOMCP_PUBLIC_URL=https://geo.example.org
# Where the container listens on the host: 127.0.0.1:8000 when nginx runs on the same machine.
GEOMCP_BIND=127.0.0.1:8000
# Only with compose.proxy.yaml (nginx in Docker): the shared Docker network nginx uses.
# GEOMCP_PROXY_NETWORK=net
# Only for the built-in Caddy alternative (docker compose --profile caddy up -d --build).
GEOMCP_DOMAIN=geo.example.org
# Optional: Google sign-in, so people connect from Claude Desktop or claude.ai with just the address
# (custom connectors accept no API key). Redirect URI to register at Google: <GEOMCP_PUBLIC_URL>/auth/callback.
# GEOMCP_ALLOWED_EMAILS is required with it: whole emails or "@domain", comma-separated. See docs/deploy-vps.md.
# GEOMCP_GOOGLE_CLIENT_ID=
# GEOMCP_GOOGLE_CLIENT_SECRET=
# GEOMCP_ALLOWED_EMAILS=@example.com, someone@gmail.com
# Optional: where sign-in may send clients back (comma-separated, `*` matches any port). The default covers
# claude.ai, Claude Desktop, mobile, Claude Code and ChatGPT; add others, e.g. Cursor, here.
# GEOMCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback, https://claude.com/api/mcp/auth_callback, https://chatgpt.com/connector_platform_oauth_redirect, http://localhost:*, http://127.0.0.1:*
# Optional: accept only these Host headers (JSON list); other names get HTTP 421.
# Without it, a server bound to 127.0.0.1 accepts only localhost names (set it when tunnelling to a local server).
# GEOMCP_ALLOWED_HOSTS=["geo.example.org"]
GEOMCP_LOG_LEVEL=INFO
# Calls estimated to take longer than this become background jobs (polled with get_job).
GEOMCP_SYNC_BUDGET_S=45
# Free Sentinel Hub quota on CDSE, used for the quota_low warning.
GEOMCP_SENTINEL_HUB_MONTHLY_UNITS=10000

# Demo source with synthetic data. Keep false in production.
GEOMCP_ENABLE_SYNTHETIC=false
